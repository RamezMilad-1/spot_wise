# Copy this file to `.env` and fill in values when you are ready to connect
# the real backends. Leaving any value blank keeps that feature on local mock data,
# so the app always runs with zero configuration.

# Firebase Realtime Database base URL.
# e.g. https://spotwise-xxxx-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DB_URL=

# Firebase Web API key — used by the Auth REST client (Identity Toolkit).
# Firebase console → Project settings → Web API key.
FIREBASE_API_KEY=

# Google Gemini API key (Google AI Studio — free tier, no credit card).
# When present, the AI planner calls Gemini; otherwise it uses the on-device generator.
GEMINI_API_KEY=
